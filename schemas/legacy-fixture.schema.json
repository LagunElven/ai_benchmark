{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/legacy-fixture.schema.json",
  "title": "Legacy benchmark fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "language", "source_status", "source", "reference_docs", "equivalence_vectors"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{2,}$"},
    "language": {"enum": ["cobol", "delphi", "wlanguage", "abal"]},
    "source_status": {"enum": ["verified_syntax", "synthetic_pseudocode", "reference_only"]},
    "source": {"type": "string", "minLength": 1},
    "reference_docs": {"type": "array", "items": {"type": "string"}},
    "equivalence_vectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["input", "expected"],
        "properties": {
          "input": {"type": "object"},
          "expected": {}
        }
      }
    }
  }
}
