{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/cohort-pilot-config.schema.json",
  "title": "Closed-loop agent cohort pilot configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "mode", "agent_counts", "tasks"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "mode": {"enum": ["one-shot", "repair"]},
    "agent_counts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
