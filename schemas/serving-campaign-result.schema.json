{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/serving-campaign-result.schema.json",
  "title": "Serving benchmark campaign result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "run", "configuration", "cases"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "git_commit": {"type": ["string", "null"]}
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "timestamp", "started_at", "ended_at", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["completed", "completed_with_failures", "failed"]}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sha256", "endpoint", "model", "model_metadata", "hardware", "serving", "matrix", "request"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "endpoint": {"type": "object"},
        "model": {"type": "string"},
        "model_metadata": {"type": "object"},
        "tokenizer": {"type": "object"},
        "hardware": {"type": "object"},
        "serving": {"type": "object"},
        "matrix": {"type": "object"},
        "request": {"type": "object"}
      }
    },
    "remote_gpu_metrics": {"type": "object"},
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "concurrency", "context_tokens", "prefix_mode", "measurement_batches", "warmup", "requests", "metrics", "resources"],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "concurrency": {"type": "integer", "minimum": 1},
          "context_tokens": {"type": "integer", "minimum": 1},
          "prefix_mode": {"enum": ["cold", "shared-prefix"]},
          "measurement_batches": {"type": "integer", "minimum": 1},
          "warmup": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requested", "batches_requested", "completed", "failed"],
            "properties": {
              "requested": {"type": "integer", "minimum": 0},
              "batches_requested": {"type": "integer", "minimum": 0},
              "completed": {"type": "integer", "minimum": 0},
              "failed": {"type": "integer", "minimum": 0}
            }
          },
          "requests": {"type": "array", "items": {"$ref": "#/$defs/requestResult"}},
          "metrics": {"type": "object"},
          "resources": {"type": "object"}
        }
      }
    }
  },
  "$defs": {
    "requestResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_id", "status", "started_offset_seconds", "ended_offset_seconds", "total_seconds", "ttft_seconds", "generation_seconds", "tpot_seconds", "input_tokens", "input_tokens_method", "output_tokens", "output_tokens_method", "error_type", "error_message", "server_metrics"],
      "properties": {
        "request_id": {"type": "string"},
        "status": {"enum": ["completed", "failed", "timeout", "oom", "incomplete"]},
        "started_offset_seconds": {"type": "number", "minimum": 0},
        "ended_offset_seconds": {"type": "number", "minimum": 0},
        "total_seconds": {"type": "number", "minimum": 0},
        "ttft_seconds": {"type": ["number", "null"], "minimum": 0},
        "generation_seconds": {"type": ["number", "null"], "minimum": 0},
        "tpot_seconds": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "input_tokens_method": {"type": ["string", "null"]},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens_method": {"type": ["string", "null"]},
        "error_type": {"type": ["string", "null"]},
        "error_message": {"type": ["string", "null"]},
        "server_metrics": {"type": "object"}
      }
    }
  }
}
