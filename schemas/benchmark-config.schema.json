{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/benchmark-config.schema.json",
  "title": "Enterprise LLM benchmark configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["benchmark", "paths", "model", "hardware", "serving", "runner"],
  "properties": {
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks", "private_tests", "results", "work"],
      "properties": {
        "tasks": {"$ref": "#/$defs/relativePath"},
        "private_tests": {"$ref": "#/$defs/relativePath"},
        "results": {"$ref": "#/$defs/relativePath"},
        "work": {"$ref": "#/$defs/relativePath"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "revision", "tokenizer_revision", "quantization", "dtype", "request_timeout_seconds", "generation"],
      "properties": {
        "provider": {"enum": ["openai_compatible", "fake"]},
        "base_url": {"type": ["string", "null"]},
        "api_key_env": {"type": ["string", "null"]},
        "name": {"type": "string", "minLength": 1},
        "revision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "quantization": {"type": ["string", "null"]},
        "dtype": {"type": ["string", "null"]},
        "request_timeout_seconds": {"type": "integer", "minimum": 1},
        "fake_response_file": {"type": "string"},
        "generation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temperature", "top_p", "max_output_tokens"],
          "properties": {
            "temperature": {"type": "number", "minimum": 0},
            "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
            "top_k": {"type": ["integer", "null"], "minimum": 0},
            "max_output_tokens": {"type": "integer", "minimum": 1},
            "seed": {"type": ["integer", "null"]}
          }
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accelerator_model", "gpu_count", "gpu_memory_gb", "driver_version", "cuda_version", "cpu_model", "host_memory_gb"],
      "properties": {
        "accelerator_model": {"type": ["string", "null"]},
        "gpu_count": {"type": ["integer", "null"], "minimum": 0},
        "gpu_memory_gb": {"type": ["number", "null"], "minimum": 0},
        "driver_version": {"type": ["string", "null"]},
        "cuda_version": {"type": ["string", "null"]},
        "cpu_model": {"type": ["string", "null"]},
        "host_memory_gb": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "launch_command", "tensor_parallel_size", "pipeline_parallel_size", "max_model_length", "prefix_caching", "batch_size", "concurrency"],
      "properties": {
        "engine": {"type": ["string", "null"]},
        "engine_version": {"type": ["string", "null"]},
        "launch_command": {"type": ["string", "null"]},
        "tensor_parallel_size": {"type": ["integer", "null"], "minimum": 1},
        "pipeline_parallel_size": {"type": ["integer", "null"], "minimum": 1},
        "max_model_length": {"type": ["integer", "null"], "minimum": 1},
        "prefix_caching": {"type": ["boolean", "null"]},
        "batch_size": {"type": ["integer", "null"], "minimum": 1},
        "concurrency": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response_protocol", "max_context_bytes", "keep_workspaces", "append_jsonl"],
      "properties": {
        "response_protocol": {"const": "file_changes_v1"},
        "max_context_bytes": {"type": "integer", "minimum": 1},
        "keep_workspaces": {"type": "boolean"},
        "append_jsonl": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {"pattern": "^(?:[A-Za-z]:|[/\\\\])"}
    }
  }
}
