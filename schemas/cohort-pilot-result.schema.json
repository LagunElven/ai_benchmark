{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/cohort-pilot-result.schema.json",
  "title": "Closed-loop agent cohort pilot result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark", "campaign", "model", "environment", "timing", "summary", "tasks", "model_requests"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "git_commit", "working_tree_dirty"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "git_commit": {"type": ["string", "null"]},
        "working_tree_dirty": {"type": ["boolean", "null"]}
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "comparison_type", "comparison_group", "workload_name", "workload_version", "workload_model", "mode", "agent_count", "configured_agent_counts", "task_ids", "task_revisions", "seed", "started_at", "ended_at", "benchmark_config_path", "benchmark_config_sha256", "cohort_plan_path", "cohort_plan_sha256"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["completed", "completed_with_failures"]},
        "comparison_type": {"const": "operational_solution"},
        "comparison_group": {"type": "string"},
        "workload_name": {"type": "string"},
        "workload_version": {"type": "string"},
        "workload_model": {"const": "closed_loop_finite_cohort"},
        "mode": {"enum": ["one-shot", "repair"]},
        "agent_count": {"type": "integer", "minimum": 1},
        "configured_agent_counts": {"type": "array", "items": {"type": "integer", "minimum": 1}},
        "task_ids": {"type": "array", "minItems": 2, "items": {"type": "string"}},
        "task_revisions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1}},
        "seed": {"type": ["integer", "null"]},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "benchmark_config_path": {"type": "string"},
        "benchmark_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "cohort_plan_path": {"type": "string"},
        "cohort_plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "source_repository", "revision", "tokenizer_revision", "quantization", "dtype", "generation"],
      "properties": {
        "provider": {"type": "string"},
        "name": {"type": "string"},
        "source_repository": {"type": ["string", "null"]},
        "revision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "quantization": {"type": ["string", "null"]},
        "dtype": {"type": ["string", "null"]},
        "generation": {"type": "object"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware_declared", "serving", "runner", "resource_metrics_source"],
      "properties": {
        "hardware_declared": {"type": "object"},
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["engine", "engine_version", "endpoint", "launch_command", "agent_concurrency", "max_num_seqs", "max_model_length", "tensor_parallel_size", "pipeline_parallel_size", "reasoning_parser", "prefix_caching", "kv_cache_dtype"],
          "properties": {
            "engine": {"type": ["string", "null"]},
            "engine_version": {"type": ["string", "null"]},
            "endpoint": {"type": ["string", "null"]},
            "launch_command": {"type": ["string", "null"]},
            "agent_concurrency": {"type": "integer", "minimum": 1},
            "max_num_seqs": {"type": ["integer", "null"], "minimum": 1},
            "max_model_length": {"type": ["integer", "null"], "minimum": 1},
            "tensor_parallel_size": {"type": ["integer", "null"], "minimum": 1},
            "pipeline_parallel_size": {"type": ["integer", "null"], "minimum": 1},
            "reasoning_parser": {"type": ["string", "null"]},
            "prefix_caching": {"type": ["boolean", "null"]},
            "kv_cache_dtype": {"type": ["string", "null"]}
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform", "python_version"],
          "properties": {
            "platform": {"type": "string"},
            "python_version": {"type": "string"}
          }
        },
        "resource_metrics_source": {"const": "not_sampled; remote GPU metrics unavailable"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at", "total_seconds"],
      "properties": {
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "total_seconds": {"type": "number", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tasks_total", "tasks_completed", "tasks_succeeded", "tasks_failed", "tasks_quality_evaluated", "tasks_capacity_rejected", "tasks_runner_errors", "task_success_rate", "tasks_per_hour", "successful_tasks_per_hour", "task_duration_p50_seconds", "task_duration_p95_seconds", "total_model_calls", "completed_model_requests", "failed_model_requests", "total_input_tokens", "total_output_tokens", "total_reasoning_tokens", "total_model_request_seconds", "average_active_model_requests", "max_concurrent_model_requests", "max_active_agents"],
      "properties": {
        "tasks_total": {"type": "integer", "minimum": 0},
        "tasks_completed": {"type": "integer", "minimum": 0},
        "tasks_succeeded": {"type": "integer", "minimum": 0},
        "tasks_failed": {"type": "integer", "minimum": 0},
        "tasks_quality_evaluated": {"type": "integer", "minimum": 0},
        "tasks_capacity_rejected": {"type": "integer", "minimum": 0},
        "tasks_runner_errors": {"type": "integer", "minimum": 0},
        "task_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "tasks_per_hour": {"type": "number", "minimum": 0},
        "successful_tasks_per_hour": {"type": "number", "minimum": 0},
        "task_duration_p50_seconds": {"type": ["number", "null"], "minimum": 0},
        "task_duration_p95_seconds": {"type": ["number", "null"], "minimum": 0},
        "total_model_calls": {"type": "integer", "minimum": 0},
        "completed_model_requests": {"type": "integer", "minimum": 0},
        "failed_model_requests": {"type": "integer", "minimum": 0},
        "total_input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_model_request_seconds": {"type": "number", "minimum": 0},
        "average_active_model_requests": {"type": "number", "minimum": 0},
        "max_concurrent_model_requests": {"type": "integer", "minimum": 0},
        "max_active_agents": {"type": "integer", "minimum": 0}
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "task_id", "task_revision", "agent_id", "started_at", "ended_at", "started_offset_seconds", "ended_offset_seconds", "duration_seconds", "run_status", "validation_outcome", "task_success", "model_calls", "input_tokens", "output_tokens", "reasoning_tokens", "result_path", "error_type", "error_types"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1},
          "task_id": {"type": "string"},
          "task_revision": {"type": "integer", "minimum": 1},
          "agent_id": {"type": "integer", "minimum": 1},
          "started_at": {"type": "string", "format": "date-time"},
          "ended_at": {"type": "string", "format": "date-time"},
          "started_offset_seconds": {"type": "number", "minimum": 0},
          "ended_offset_seconds": {"type": "number", "minimum": 0},
          "duration_seconds": {"type": "number", "minimum": 0},
          "run_status": {"type": ["string", "null"]},
          "validation_outcome": {"enum": ["passed", "public_passed", "failed", "not_run"]},
          "task_success": {"type": ["boolean", "null"]},
          "model_calls": {"type": "integer", "minimum": 0},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
          "result_path": {"type": ["string", "null"]},
          "error_type": {"type": ["string", "null"]},
          "error_types": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "model_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_id", "task_id", "agent_id", "started_offset_seconds", "ended_offset_seconds", "duration_seconds", "status", "input_tokens", "output_tokens", "reasoning_tokens", "cached_input_tokens", "error_type"],
        "properties": {
          "request_id": {"type": "string"},
          "task_id": {"type": ["string", "null"]},
          "agent_id": {"type": ["integer", "null"], "minimum": 1},
          "started_offset_seconds": {"type": "number", "minimum": 0},
          "ended_offset_seconds": {"type": ["number", "null"], "minimum": 0},
          "duration_seconds": {"type": ["number", "null"], "minimum": 0},
          "status": {"enum": ["running", "completed", "failed"]},
          "input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "output_tokens": {"type": ["integer", "null"], "minimum": 0},
          "reasoning_tokens": {"type": ["integer", "null"], "minimum": 0},
          "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
          "error_type": {"type": ["string", "null"]}
        }
      }
    }
  }
}
