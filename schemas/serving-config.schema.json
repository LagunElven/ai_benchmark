{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/enterprise-llm-bench/serving-config.schema.json",
  "title": "Serving benchmark configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "endpoint", "model", "model_metadata", "hardware", "serving", "matrix", "request"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url", "api_key_env"],
      "properties": {
        "base_url": {"type": "string", "minLength": 1},
        "api_key_env": {"type": ["string", "null"]}
      }
    },
    "model": {"type": "string", "minLength": 1},
    "model_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "tokenizer_revision", "quantization", "dtype"],
      "properties": {
        "revision": {"type": ["string", "null"]},
        "tokenizer_revision": {"type": ["string", "null"]},
        "quantization": {"type": ["string", "null"]},
        "dtype": {"type": ["string", "null"]}
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accelerator_model", "gpu_count", "gpu_memory_gb", "driver_version", "cuda_version", "cpu_model", "host_memory_gb"],
      "properties": {
        "accelerator_model": {"type": ["string", "null"]},
        "gpu_count": {"type": ["integer", "null"], "minimum": 0},
        "gpu_memory_gb": {"type": ["number", "null"], "minimum": 0},
        "driver_version": {"type": ["string", "null"]},
        "cuda_version": {"type": ["string", "null"]},
        "cpu_model": {"type": ["string", "null"]},
        "host_memory_gb": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "engine_version", "launch_command", "tensor_parallel_size", "pipeline_parallel_size", "max_model_length", "prefix_caching", "batch_size"],
      "properties": {
        "engine": {"type": ["string", "null"]},
        "engine_version": {"type": ["string", "null"]},
        "launch_command": {"type": ["string", "null"]},
        "tensor_parallel_size": {"type": ["integer", "null"], "minimum": 1},
        "pipeline_parallel_size": {"type": ["integer", "null"], "minimum": 1},
        "max_model_length": {"type": ["integer", "null"], "minimum": 1},
        "prefix_caching": {"type": ["boolean", "null"]},
        "batch_size": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["concurrency", "context_tokens", "prefix_modes", "warmup_requests", "repetitions"],
      "properties": {
        "concurrency": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "context_tokens": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "prefix_modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cold", "shared-prefix"]}},
        "warmup_requests": {"type": "integer", "minimum": 0},
        "repetitions": {"type": "integer", "minimum": 1}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timeout_seconds", "max_output_tokens", "temperature", "top_p", "seed", "stream"],
      "properties": {
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]},
        "stream": {"const": true}
      }
    }
  }
}
